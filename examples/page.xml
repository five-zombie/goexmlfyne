<goexml version="0.1.0">
  <!-- page.xml: the shell stays in XML; the body arrives from Go.
       Run with: go run ./cmd/demo page.xml -->
  <window title="Page">
    <container id="page">
      <vbox id="shell" style="p-2" spacing="8">
        <label id="head" text="goexml page" />
        <slot style="h-full" />
        <label id="foot" text="footer stays in XML" />
      </vbox>
    </container>
  </window>
</goexml>
