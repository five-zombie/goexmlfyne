<!-- feed-item.xml: one row of the showcase's <vbox-expand> feed.
     The demo commits several copies; ids stay private to each row. -->
<goexml-item version="0.1.0">
  <vbox id="row" spacing="2" style="bg-[#1e293b] rounded-md p-2">
    <label id="rowTitle" text="{{title}}" />
    <text id="rowBody">Drafted and committed at runtime from this
fragment: the layout lives here, the data comes from the app.</text>
  </vbox>
</goexml-item>
